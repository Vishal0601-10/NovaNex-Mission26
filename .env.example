# Production HTTP server. Keep 127.0.0.1 when running only on your own laptop.
HOST=127.0.0.1
PORT=8080

# Persistent account ledger. Relative paths are evaluated from the project folder.
ACCOUNT_LEDGER_PATH=./data/account_ledger.local.json

# Strongly recommended when HOST is 0.0.0.0 or the app is reachable by anyone else.
# Use at least 24 random characters. Do not commit the real key.
ACCOUNT_WRITE_API_KEY=
REQUIRE_WRITE_API_KEY=false

# Maximum accepted JSON request body.
MAX_REQUEST_BODY_BYTES=1048576
